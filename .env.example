# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<urlencoded-pass>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=proofgate
# Both keys: private random values, at least 24 characters; the API refuses to start otherwise.
# Generate each with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# The team shares them by private DM with MONGODB_URI. The console key is typed into the UI's "Console key" box.
AGENT_SERVICE_KEY=
CONSOLE_KEY=
GATE_URL=http://localhost:8080
# One process: gate, mock target and fallback UI all on 8080
TARGET_URL=http://localhost:8080
# Only `make test-conflict` turns this on (it sets it itself). Keep false.
DEMO_DEBUG_HOOKS=false
# Triage agent (LangGraph): Voyage embeddings + rerank, Atlas Vector Search. Without the key it labels proposals rules-v1.
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-2.5
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proofgate
ELEVENLABS_API_KEY=
# Detector + compensation worker run as threads in the API (1). Set 0 and run `make detector` for the kill/restart demo.
# Keep comments on their own lines: the Makefile loads this file and would keep spaces before an inline comment.
RUN_BACKGROUND=1

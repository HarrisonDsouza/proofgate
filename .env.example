# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<urlencoded-pass>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=proofgate
AGENT_SERVICE_KEY=dev-agent-key-change-me
GATE_URL=http://localhost:8080
# One process: gate, mock target and fallback UI all on 8080
TARGET_URL=http://localhost:8080
DEMO_DEBUG_HOOKS=true
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=
VOYAGE_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proofgate
ELEVENLABS_API_KEY=
# Detector + compensation worker run as threads in the API (1). Set 0 and run `make detector` for the kill/restart demo.
# Keep comments on their own lines: the Makefile loads this file and would keep spaces before an inline comment.
RUN_BACKGROUND=1
